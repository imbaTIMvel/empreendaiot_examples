{
  "version": 1,
  "author": "Monitoria - Trilha IoT",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-v1",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": { "env": "micropython-20231227-v1.22.0" }
    },
    {
      "type": "board-ssd1306",
      "id": "oled",
      "top": -150,
      "left": 190,
      "attrs": { "i2cAddress": "0x3c" }
    },
    {
      "type": "wokwi-dht22",
      "id": "dht",
      "top": -60,
      "left": -230,
      "attrs": { "temperature": "21.4", "humidity": "59" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn",
      "top": 210,
      "left": 190,
      "attrs": { "color": "green", "label": "TELA" }
    }
  ],
  "connections": [
    [ "esp:TX0", "$serialMonitor:RX", "", [] ],
    [ "esp:RX0", "$serialMonitor:TX", "", [] ],

    [ "oled:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "oled:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "oled:SDA", "esp:D21", "green", [ "v0" ] ],
    [ "oled:SCL", "esp:D22", "blue", [ "v0" ] ],

    [ "dht:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "dht:GND", "esp:GND.2", "black", [ "v0" ] ],
    [ "dht:SDA", "esp:D4", "orange", [ "v0" ] ],

    [ "btn:1.l", "esp:D14", "purple", [ "v0" ] ],
    [ "btn:2.l", "esp:GND.3", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}
