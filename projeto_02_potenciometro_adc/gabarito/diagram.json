{
  "version": 1,
  "author": "Monitoria - Trilha IoT",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-v1",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": { "env": "micropython-20231227-v1.22.0" }
    },
    {
      "type": "wokwi-potentiometer",
      "id": "pot1",
      "top": -80,
      "left": -220,
      "attrs": {}
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 120,
      "left": 240,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-led",
      "id": "led1",
      "top": 100,
      "left": 340,
      "rotate": 90,
      "attrs": { "color": "yellow" }
    }
  ],
  "connections": [
    [ "esp:TX0", "$serialMonitor:RX", "", [] ],
    [ "esp:RX0", "$serialMonitor:TX", "", [] ],

    [ "pot1:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "pot1:GND", "esp:GND.2", "black", [ "v0" ] ],
    [ "pot1:SIG", "esp:D34", "green", [ "v0" ] ],

    [ "esp:D23", "r1:1", "orange", [ "v0" ] ],
    [ "r1:2", "led1:A", "orange", [ "v0" ] ],
    [ "led1:C", "esp:GND.3", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}
