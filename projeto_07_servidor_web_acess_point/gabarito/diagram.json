{
  "version": 1,
  "author": "Monitoria - Trilha IoT",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-v1",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": { "env": "micropython-20231227-v1.22.0" }
    },
    {
      "type": "wokwi-dht22",
      "id": "dht",
      "top": -60,
      "left": -230,
      "attrs": { "temperature": "21.4", "humidity": "59" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 120,
      "left": 240,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-led",
      "id": "led1",
      "top": 100,
      "left": 340,
      "rotate": 90,
      "attrs": { "color": "red", "label": "CARGA" }
    }
  ],
  "connections": [
    [ "esp:TX0", "$serialMonitor:RX", "", [] ],
    [ "esp:RX0", "$serialMonitor:TX", "", [] ],

    [ "dht:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "dht:GND", "esp:GND.2", "black", [ "v0" ] ],
    [ "dht:SDA", "esp:D4", "orange", [ "v0" ] ],

    [ "esp:D23", "r1:1", "green", [ "v0" ] ],
    [ "r1:2", "led1:A", "green", [ "v0" ] ],
    [ "led1:C", "esp:GND.3", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}
